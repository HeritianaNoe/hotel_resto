generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        BigInt   @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  fullName  String?  @map("full_name") @db.VarChar(100)
  password  String   @db.VarChar(100)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  roles             UserRole[]
  waiterOrders      FoodOrder[]   @relation("WaiterOrders")
  guestOrders       FoodOrder[]   @relation("GuestOrders")
  cashierInvoices   Invoice[]
  guestReservations Reservation[]

  @@map("users")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(30)

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId Int    @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Room {
  id            BigInt  @id @default(autoincrement())
  number        String  @unique @db.VarChar(10)
  type          String  @db.VarChar(20)
  pricePerNight Decimal @map("price_per_night") @db.Decimal(12, 2)
  status        String  @default("AVAILABLE") @db.VarChar(20)

  reservations Reservation[]

  @@map("rooms")
}

model Reservation {
  id         BigInt    @id @default(autoincrement())
  roomId     BigInt    @map("room_id")
  guestId    BigInt    @map("guest_id")
  checkIn    DateTime  @map("check_in") @db.Date
  checkOut   DateTime  @map("check_out") @db.Date
  status     String    @db.VarChar(20)
  totalPrice Decimal?  @map("total_price") @db.Decimal(12, 2)

  room  Room @relation(fields: [roomId], references: [id])
  guest User @relation(fields: [guestId], references: [id])

  @@map("reservations")
}

model DiningTable {
  id     BigInt @id @default(autoincrement())
  number Int    @unique
  seats  Int

  foodOrders FoodOrder[]

  @@map("dining_tables")
}

model MenuItem {
  id          BigInt  @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)
  price       Decimal @db.Decimal(12, 2)
  category    String? @db.VarChar(50)
  available   Boolean @default(true)

  orderItems OrderItem[]

  @@map("menu_items")
}

model FoodOrder {
  id            BigInt   @id @default(autoincrement())
  diningTableId BigInt   @map("dining_table_id")
  waiterId      BigInt?  @map("waiter_id")
  guestId       BigInt?  @map("guest_id")
  status        String   @db.VarChar(20)
  createdAt     DateTime @map("created_at")

  diningTable DiningTable @relation(fields: [diningTableId], references: [id])
  waiter      User?       @relation("WaiterOrders", fields: [waiterId], references: [id])
  guest       User?       @relation("GuestOrders", fields: [guestId], references: [id])
  orderItems  OrderItem[]
  invoice     Invoice?

  @@map("food_orders")
}

model OrderItem {
  id          BigInt  @id @default(autoincrement())
  foodOrderId BigInt  @map("food_order_id")
  menuItemId  BigInt  @map("menu_item_id")
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)

  foodOrder FoodOrder @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

model Invoice {
  id          BigInt   @id @default(autoincrement())
  foodOrderId BigInt   @unique @map("food_order_id")
  cashierId   BigInt?  @map("cashier_id")
  amount      Decimal  @db.Decimal(12, 2)
  method      String   @db.VarChar(20)
  paidAt      DateTime @map("paid_at")

  foodOrder FoodOrder @relation(fields: [foodOrderId], references: [id])
  cashier   User?     @relation(fields: [cashierId], references: [id])

  @@map("invoices")
}

model StockItem {
  id       BigInt   @id @default(autoincrement())
  name     String   @unique @db.VarChar(100)
  quantity Decimal  @db.Decimal(12, 2)
  unit     String?  @db.VarChar(20)
  minLevel Decimal? @map("min_level") @db.Decimal(12, 2)
  supplier String?  @db.VarChar(100)

  @@map("stock_items")
}
